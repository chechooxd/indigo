{
  "name": "indigodb",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo dev",
    "build": "turbo build",
    "clean": "turbo clean",
    "lint": "turbo lint",
    "test": "turbo test && node scripts/check-pack-contents.mjs && node scripts/check-release-cohort.mjs && node scripts/check-realtime-projection-db-gate.mjs && node scripts/test-audit-gate.mjs",
    "release:preflight": "pnpm clean && pnpm build --force && pnpm lint && pnpm test",
    "ci:local": "act -j ts",
    "test:postgres": "./scripts/test-postgres.sh"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreCves": []
    }
  }
}
