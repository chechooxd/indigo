{
  "name": "@indigodb/core",
  "version": "0.1.1",
  "description": "Relational intermediate representation (IR), schema resolver, and printer for IndigoDB.",
  "keywords": [
    "indigodb",
    "ir",
    "schema",
    "orm",
    "postgresql"
  ],
  "homepage": "https://github.com/chechooxd/indigo#readme",
  "bugs": "https://github.com/chechooxd/indigo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chechooxd/indigo.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .turbo",
    "lint": "tsc --noEmit",
    "test": "node test/print.mjs"
  },
  "dependencies": {
    "@indigodb/ast": "workspace:*",
    "@indigodb/compiler": "workspace:*",
    "@indigodb/parser": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
