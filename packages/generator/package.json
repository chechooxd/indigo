{
  "name": "@indigodb/generator",
  "version": "0.0.1",
  "description": "Typed TypeScript ORM client code generator for IndigoDB schemas.",
  "keywords": ["indigodb", "codegen", "generator", "typescript", "orm", "postgresql"],
  "homepage": "https://github.com/chechooxd/indigo#readme",
  "bugs": "https://github.com/chechooxd/indigo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chechooxd/indigo.git",
    "directory": "packages/generator"
  },
  "files": ["dist"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .turbo",
    "lint": "tsc --noEmit",
    "test": "node test/enum-mapping.mjs && node test/transaction-emission.mjs && node test/auth-emission.mjs && node test/relation-emission.mjs && node test/nested-write-emission.mjs && node test/where-emission.mjs && node test/live-emit.mjs && node test/index-emission.mjs"
  },
  "dependencies": {
    "@indigodb/ast": "workspace:*",
    "@indigodb/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
