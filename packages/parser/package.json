{
  "name": "@indigodb/parser",
  "version": "0.0.1",
  "description": "Parser wrapper around the IndigoDB WebAssembly compiler.",
  "keywords": ["indigodb", "parser", "schema", "orm", "postgresql"],
  "files": ["dist"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .turbo",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@indigodb/ast": "workspace:*",
    "@indigodb/compiler": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
