{
  "name": "@indigodb/ast",
  "version": "0.1.0",
  "description": "Shared TypeScript AST and diagnostic types for the IndigoDB schema language.",
  "keywords": [
    "indigodb",
    "ast",
    "schema",
    "orm",
    "postgresql"
  ],
  "homepage": "https://github.com/chechooxd/indigo#readme",
  "bugs": "https://github.com/chechooxd/indigo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chechooxd/indigo.git",
    "directory": "packages/ast"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
