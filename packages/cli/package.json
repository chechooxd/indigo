{
  "name": "@indigodb/cli",
  "version": "0.1.0",
  "description": "Command-line interface for IndigoDB (init, db push/pull, migrate, generate, realtime, studio).",
  "keywords": [
    "indigodb",
    "cli",
    "orm",
    "migrations",
    "studio",
    "postgresql"
  ],
  "homepage": "https://github.com/chechooxd/indigo#readme",
  "bugs": "https://github.com/chechooxd/indigo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chechooxd/indigo.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "indigodb": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .turbo",
    "lint": "tsc --noEmit",
    "test": "node test/run-all.mjs"
  },
  "dependencies": {
    "@indigodb/core": "workspace:*",
    "@indigodb/parser": "workspace:*",
    "@indigodb/generator": "workspace:*",
    "@indigodb/migrator": "workspace:*",
    "@indigodb/realtime": "workspace:*",
    "@indigodb/studio": "workspace:*",
    "commander": "^13.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/pg": "^8.11.0",
    "typescript": "^5.8.0"
  }
}
