// Regression, fixed in PR2: only `onDelete` changes (Cascade → SetNull);
// columns/refTable/refColumns are unchanged. `fkDefinition()` (identity +
// referential actions) detects the action-only change and re-issues the
// SAME-named constraint (DROP in 3a, ADD in 3c) instead of `fkSignature`
// alone, which would see "the same FK" on both sides and emit zero DDL.

Table User {
  id Int @id @default(autoincrement())
}

Table Post {
  id       Int  @id @default(autoincrement())
  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: SetNull)
}
