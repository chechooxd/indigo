// Regression, fixed in PR2: Post is declared before the User table it
// references. The 3a/3b/3c pass defers every FK constraint into a dedicated
// pass (3c) that runs after every table is created, so `CREATE TABLE
// "User"` exists before `Post`'s FK constraint references it — regardless
// of declaration order.

Table Post {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])
}

Table User {
  id    Int    @id @default(autoincrement())
  posts Post[]
}
