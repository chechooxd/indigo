{
  "name": "@indigodb/migrator",
  "version": "0.1.0",
  "description": "PostgreSQL schema diffing, DDL migration generator, and catalog introspector for IndigoDB.",
  "keywords": [
    "indigodb",
    "migrations",
    "ddl",
    "introspection",
    "orm",
    "postgresql"
  ],
  "homepage": "https://github.com/chechooxd/indigo#readme",
  "bugs": "https://github.com/chechooxd/indigo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chechooxd/indigo.git",
    "directory": "packages/migrator"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .turbo",
    "lint": "tsc --noEmit",
    "test": "node test/migrator.mjs && node test/native-type.mjs && node test/index-ddl.mjs && node test/rls.mjs && node test/rls-enforcement.mjs && node test/realtime-ddl.mjs && node test/appliability.mjs && node test/replay.mjs && node test/introspect.mjs && node test/shadow.mjs && node test/pull-roundtrip.mjs",
    "test:goldens": "node test/migrator.mjs",
    "test:native-type": "node test/native-type.mjs",
    "test:rls": "node test/rls.mjs",
    "test:rls-enforcement": "node test/rls-enforcement.mjs",
    "test:index-ddl": "node test/index-ddl.mjs",
    "test:realtime-ddl": "node test/realtime-ddl.mjs",
    "test:appliability": "node test/appliability.mjs",
    "test:replay": "node test/replay.mjs",
    "test:introspect": "node test/introspect.mjs",
    "test:shadow": "node test/shadow.mjs",
    "test:pull-roundtrip": "node test/pull-roundtrip.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@indigodb/ast": "workspace:*",
    "@indigodb/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
